{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "仓鼠小助手",
  "version": "1.0.2",
  "identifier": "hamster-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "仓鼠小助手",
        "width": 1280,
        "height": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/catalog.sqlite",
      "resources/user.sqlite",
      "resources/userdict.json",
      "resources/warframe_nicknames.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
